        <!-- Key Notes -->
        <mxCell id="notes-title" value="KEY NOTES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1190" width="280" height="30" as="geometry" />
        </mxCell>

        <mxCell id="notes-content" value="1. Customer Agreement holds standalone&#xa;   invoices (not linked to cases)&#xa;&#xa;2. Case outstanding = caseAmount - totalPaid&#xa;   (only PAID invoices count)&#xa;&#xa;3. Invoice outstanding = amount - payments&#xa;&#xa;4. Expected cashflow = Predictive + Non-&#xa;   Predicted Invoices + Payment Plans&#xa;   (no double-counting)&#xa;&#xa;5. Predictive analytics requires 3+ paid&#xa;   invoices on a case&#xa;&#xa;6. Auto-convert: standalone invoices 30+&#xa;   days overdue → create case&#xa;&#xa;7. Cache TTL: 5 minutes, auto-invalidates&#xa;   on invoice mutations&#xa;&#xa;8. All time forecast = 90 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1230" width="280" height="310" as="geometry" />
        </mxCell>

