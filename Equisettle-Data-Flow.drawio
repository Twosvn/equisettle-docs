        <mxCell id="rcRPpLXe8mQyC9XRr0L7-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Payment&lt;/b&gt;&lt;br&gt;Model: Payment&lt;br&gt;- paymentId&lt;br&gt;- paymentAmount&lt;br&gt;- paymentDate&lt;br&gt;- paymentStatus (completed/success)&lt;br&gt;- invoice (ref)&lt;br&gt;- company (ref)" vertex="1">
          <mxGeometry height="140" width="180" x="260" y="170" as="geometry" />
