        <mxCell id="rcRPpLXe8mQyC9XRr0L7-12" connectable="0" parent="rcRPpLXe8mQyC9XRr0L7-11" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="tracked in" vertex="1">
          <mxGeometry relative="1" x="-0.2" y="2" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rcRPpLXe8mQyC9XRr0L7-13" edge="1" parent="1" source="rcRPpLXe8mQyC9XRr0L7-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="rcRPpLXe8mQyC9XRr0L7-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rcRPpLXe8mQyC9XRr0L7-14" connectable="0" parent="rcRPpLXe8mQyC9XRr0L7-13" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="type: credit_note" vertex="1">
          <mxGeometry relative="1" x="-0.2" y="2" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rcRPpLXe8mQyC9XRr0L7-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" value="ANALYTICS &amp; FORECASTING LAYER" vertex="1">
          <mxGeometry height="40" width="900" x="40" y="550" as="geometry" />
        </mxCell>
        <mxCell id="rcRPpLXe8mQyC9XRr0L7-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="&lt;b&gt;Cash Flow Controller&lt;/b&gt;&lt;br&gt;File: cashFlowController.js&lt;br&gt;&lt;br&gt;&lt;b&gt;Historical Analysis (Last 30 days):&lt;/b&gt;&lt;br&gt;- Query Payment (completed/success)&lt;br&gt;- Query APRecord (all types)&lt;br&gt;- Calculate: historicalOutflow = expenses - credit_notes&lt;br&gt;- Calculate: avgWeeklyInflow, avgWeeklyOutflow&lt;br&gt;&lt;br&gt;&lt;b&gt;Weekly Forecast (12 weeks):&lt;/b&gt;&lt;br&gt;&lt;u&gt;Inflows:&lt;/u&gt;&lt;br&gt;• AI Predicted (from PredictiveAnalytics)&lt;br&gt;• Invoice-Based (invoices.dueDate)&lt;br&gt;• Payment Plan Installments&lt;br&gt;&lt;br&gt;&lt;u&gt;Outflows:&lt;/u&gt;&lt;br&gt;• Scheduled (APRecord with paymentDate)&lt;br&gt;• Credit Note Reductions (APRecord type=credit_note)&lt;br&gt;• Estimated (avgWeeklyOutflow or 30% of revenue)&lt;br&gt;&lt;br&gt;&lt;b&gt;Calculation:&lt;/b&gt;&lt;br&gt;totalOutflow = scheduledExpenses - creditNotes + estimated&lt;br&gt;netCashFlow = totalInflow - totalOutflow&lt;br&gt;cumulativeCash += netCashFlow" vertex="1">
          <mxGeometry height="400" width="380" x="40" y="610" as="geometry" />
        </mxCell>
        <mxCell id="rcRPpLXe8mQyC9XRr0L7-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="&lt;b&gt;Predictive Analytics&lt;/b&gt;&lt;br&gt;Model: PredictiveAnalytics&lt;br&gt;- company (ref)&lt;br&gt;- cashFlowForecast[]&lt;br&gt;&amp;nbsp;&amp;nbsp;- weekStartDate&lt;br&gt;&amp;nbsp;&amp;nbsp;- expectedAmount&lt;br&gt;- analyticsPredictions&lt;br&gt;&amp;nbsp;&amp;nbsp;- predictedPaymentDate&lt;br&gt;&amp;nbsp;&amp;nbsp;- paymentProbability&lt;br&gt;&amp;nbsp;&amp;nbsp;- riskLevel" vertex="1">
          <mxGeometry height="180" width="220" x="460" y="610" as="geometry" />
        </mxCell>
        <mxCell id="rcRPpLXe8mQyC9XRr0L7-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="&lt;b&gt;Scenario Analysis&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Best Case:&lt;/b&gt;&lt;br&gt;+20% inflows, -10% outflows&lt;br&gt;&lt;br&gt;&lt;b&gt;Base Case:&lt;/b&gt;&lt;br&gt;Expected forecast&lt;br&gt;&lt;br&gt;&lt;b&gt;Worst Case:&lt;/b&gt;&lt;br&gt;-20% inflows, +10% outflows&lt;br&gt;&lt;br&gt;Calculates runway for each scenario" vertex="1">
          <mxGeometry height="200" width="220" x="460" y="810" as="geometry" />
        </mxCell>
