          <mxGeometry height="160" width="200" x="40" y="330" as="geometry" />
        </mxCell>
        <mxCell id="rcRPpLXe8mQyC9XRr0L7-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Payment Plan&lt;/b&gt;&lt;br&gt;Model: PaymentPlanArrangement&lt;br&gt;- schedule[]&lt;br&gt;&amp;nbsp;&amp;nbsp;- dueDate&lt;br&gt;&amp;nbsp;&amp;nbsp;- expectedAmount&lt;br&gt;&amp;nbsp;&amp;nbsp;- paidAmount&lt;br&gt;&amp;nbsp;&amp;nbsp;- status (pending/paid)&lt;br&gt;- status (active)" vertex="1">
          <mxGeometry height="160" width="180" x="260" y="330" as="geometry" />
        </mxCell>
        <mxCell id="rcRPpLXe8mQyC9XRr0L7-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="OUTFLOWS (Cash Going Out)" vertex="1">
          <mxGeometry height="40" width="400" x="540" y="110" as="geometry" />
        </mxCell>
        <mxCell id="rcRPpLXe8mQyC9XRr0L7-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Expenses&lt;/b&gt;&lt;br&gt;Model: Expense&lt;br&gt;- expenseId&lt;br&gt;- title&lt;br&gt;- amount&lt;br&gt;- dueDate&lt;br&gt;- status (Paid/Unpaid)&lt;br&gt;- paidDate&lt;br&gt;- supplier (ref)" vertex="1">
          <mxGeometry height="140" width="180" x="540" y="170" as="geometry" />
        </mxCell>
        <mxCell id="rcRPpLXe8mQyC9XRr0L7-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;AP Record&lt;/b&gt;&lt;br&gt;Model: APRecord (AccountsPayable)&lt;br&gt;- recordId&lt;br&gt;- amount&lt;br&gt;- paymentDate&lt;br&gt;- status (paid/unpaid/partially_paid)&lt;br&gt;- type (expense/credit_note)&lt;br&gt;- expense (ref)&lt;br&gt;- invoice (ref)" vertex="1">
          <mxGeometry height="160" width="180" x="760" y="170" as="geometry" />
        </mxCell>
        <mxCell id="rcRPpLXe8mQyC9XRr0L7-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Credit Notes (Supplier)&lt;/b&gt;&lt;br&gt;Type: credit_note in APRecord&lt;br&gt;- Reduces outflows&lt;br&gt;- Supplier refunds/credits&lt;br&gt;- E.g., CRT-NF75 (£18,665.03)" vertex="1">
          <mxGeometry height="140" width="180" x="760" y="350" as="geometry" />
        </mxCell>
        <mxCell id="rcRPpLXe8mQyC9XRr0L7-11" edge="1" parent="1" source="rcRPpLXe8mQyC9XRr0L7-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" target="rcRPpLXe8mQyC9XRr0L7-9">
